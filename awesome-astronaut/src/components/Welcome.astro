---
import img4127 from "../assets/images/IMG_4127.jpg";
import img4218 from "../assets/images/IMG_4218.jpg";
import img6883 from "../assets/images/IMG_6883.jpeg";
import img7063 from "../assets/images/IMG_7063.jpeg";
import img8085 from "../assets/images/IMG_8085.png";
import img3549 from "../assets/images/IMG_3549.png";
import img3548 from "../assets/images/IMG_3548.png";
import img7711 from "../assets/images/IMG_7711.png";
import logo from "../assets/logo-bg-removed.png";
import jordan from "../assets/jordan.jpg";
import marbleWhite from "../assets/stone-white-2.jpg";
import marbleBlack from "../assets/marble-black.svg";

const services = [
  "HVAC/R",
  "Lite Electrical",
  "Lite Plumbing",
  "Appliance Installation/Repair",
  "Kitchen/Bathroom Renovation",
  "Drywall Repair/Install",
  "Carpentry",
  "Cabinetry",
  "Light Fixtures/Ceiling Fan Installation",
  "Home Entertainment Sound System Install",
  "TV Mounting",
  "Electrical Fireplace Mounting",
  "Furniture Assembly",
  "Picture/Drape Hanging",
];

const projects = [
	{ src: img4127.src, alt: "Completed project work" },
	{ src: img4218.src, alt: "Completed project work" },
	{ src: img6883.src, alt: "Completed project work" },
	{ src: img7063.src, alt: "Completed project work" },
	{ src: img8085.src, alt: "TV mounted above fireplace" },
	{ src: img3549.src, alt: "Technician installing wall fixture" },
	{ src: img3548.src, alt: "Large TV installation", objectPosition: "50% 20%" },
	{ src: img7711.src, alt: "Office storage and shelving installation" },
];

const contactItems = [
  {
    label: "Phone",
    value: "678-727-3854",
    href: "tel:+16787273854",
    icon: "phone",
  },
  {
    label: "Email",
    value: "jordan.a.mcghee@hotmail.com",
    href: "mailto:jordan.a.mcghee@hotmail.com",
    icon: "email",
  },
  {
    label: "Service Area",
    value: "Nashville, TN & Surrounding Areas",
    href: null,
    icon: "map",
  },
  {
    label: "Owner",
    value: "Jordan McGhee",
    href: null,
    icon: "user",
  },
];
---

<div
  class="page"
  style={`--marble-white: url(${marbleWhite.src}); --marble-black: url(${marbleBlack.src});`}
>
  <div class="band band-light">
    <header class="header">
      <button
        class="menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span class="menu-toggle-bar"></span>
        <span class="menu-toggle-bar"></span>
        <span class="menu-toggle-bar"></span>
      </button>

      <nav id="site-nav" class="nav">
        <a href="#services">Services</a>
        <a href="#work">Work</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <section id="hero" class="hero wrap">
      <div class="column">
        <p class="eyebrow">
          Safe &amp; Professional · High Quality &amp; Efficient
        </p>
        <h1>
          <span class="text-gradient">
            <span class="text-gradient-base">Major Maintenance</span>
            <span class="shimmer" aria-hidden="true">Major Maintenance</span>
          </span>
          <span class="hero-subline">Installs &amp; Repairs</span>
        </h1>
        <p class="subtitle">“It may not be easy, but it is possible.”</p>
        <a class="btn" href="#contact">Request a quote</a>
      </div>
      <div class="column">
        <img
          class="hero-logo"
          src={logo.src}
          alt="Major Maintenance Installs & Repairs"
          width="450"
          height="450"
        />
      </div>
    </section>

    <ul class="contact-strip wrap">
      {
        contactItems.map((item) => (
          <li class="contact-item">
            <span class="icon-circle" aria-hidden="true">
              {item.icon === "phone" && (
                <svg viewBox="0 0 24 24">
                  <path
                    d="M7.5 4.5h3l1.2 4.2-1.8 1.2a12 12 0 0 0 4.2 4.2l1.2-1.8 4.2 1.2v3a1.5 1.5 0 0 1-1.5 1.5A14.5 14.5 0 0 1 6 6a1.5 1.5 0 0 1 1.5-1.5Z"
                    fill="currentColor"
                  />
                </svg>
              )}
              {item.icon === "email" && (
                <svg viewBox="0 0 24 24">
                  <path
                    d="M4 7.5A1.5 1.5 0 0 1 5.5 6h13A1.5 1.5 0 0 1 20 7.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 16.5v-9Zm1.7.7 6.3 4.2 6.3-4.2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linejoin="round"
                  />
                </svg>
              )}
              {item.icon === "map" && (
                <svg viewBox="0 0 24 24">
                  <path
                    d="M12 21s6-5.2 6-10a6 6 0 1 0-12 0c0 4.8 6 10 6 10Zm0-7.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"
                    fill="currentColor"
                  />
                </svg>
              )}
              {item.icon === "user" && (
                <svg viewBox="0 0 24 24">
                  <path
                    d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm0 2c-4 0-7 2-7 4.5V20h14v-1.5C19 16 16 14 12 14Z"
                    fill="currentColor"
                  />
                </svg>
              )}
            </span>
            <span class="contact-label">{item.label}</span>
            {item.href ? (
              <a href={item.href}>{item.value}</a>
            ) : (
              <span class="contact-value">{item.value}</span>
            )}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="section-break section-break-dark" aria-hidden="true">
    <span class="section-break-text"> Skills &amp; Services </span>
  </div>

  <main class="band">
    <section id="services" class="section wrap">
      <ul class="services">
        {
          services.map((service) => (
            <li class="service">
              <svg class="service-check" viewBox="0 0 20 20" aria-hidden="true">
                <rect
                  x="2.5"
                  y="2.5"
                  width="15"
                  height="15"
                  rx="1.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M6 10.2l2.6 2.6 5.4-5.6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span>{service}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="section-break" aria-hidden="true">
      <span class="section-break-text">
        <span class="text-light">Previous</span>
        <span class="text-gradient">Work</span>
      </span>
    </div>

    <section id="work" class="section wrap">
      <div class="carousel" data-carousel>
        <button
          class="carousel-btn prev"
          type="button"
          aria-label="Previous project"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M15 6l-6 6 6 6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>

        <div
          class="carousel-track"
          tabindex="0"
          aria-label="Previous work gallery"
        >
          {
            projects.map((project) => (
              <figure class="carousel-slide">
                <img
                  src={project.src}
                  alt={project.alt}
                  loading="lazy"
                  style={project.objectPosition
                    ? `object-position: ${project.objectPosition}`
                    : undefined}
                />
              </figure>
            ))
          }
        </div>

        <button
          class="carousel-btn next"
          type="button"
          aria-label="Next project"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M9 6l6 6-6 6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </section>

    <div class="section-break section-break-dark" aria-hidden="true">
      <span class="section-break-text">
        <span class="text-light">Get In Touch</span>
      </span>
    </div>

    <section id="contact" class="section wrap">
      <div class="contact-grid">
        <form class="form" data-contact-form>
          <label>
            <span>Name</span>
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label>
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <label>
            <span>Phone</span>
            <input type="tel" name="phone" autocomplete="tel" />
          </label>
          <label class="full">
            <span>Message</span>
            <textarea name="message" rows="4" required></textarea>
          </label>
          <label class="full checkbox-label">
            <input type="checkbox" name="quote" value="yes" />
            <span>Yes, I would like a quote</span>
          </label>
          <button class="btn" type="submit">Send message</button>
          <p class="form-status" hidden>
            Thanks — I’ll get back to you shortly.
          </p>
        </form>

        <figure class="contact-photo">
          <img src={jordan.src} alt="Jordan McGhee" loading="lazy" height={550}/>
        </figure>
      </div>
    </section>

    <footer class="footer wrap">
      <a class="cta" href="tel:+18599139972">
        <span class="icon-circle cta-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path
              d="M7.5 4.5h3l1.2 4.2-1.8 1.2a12 12 0 0 0 4.2 4.2l1.2-1.8 4.2 1.2v3a1.5 1.5 0 0 1-1.5 1.5A14.5 14.5 0 0 1 6 6a1.5 1.5 0 0 1 1.5-1.5Z"
              fill="currentColor"></path>
          </svg>
        </span>
        <span class="cta-copy">
          <span class="cta-top">Call Today</span>
          <span class="cta-bottom text-gradient">For Reliable Service</span>
        </span>
      </a>
      <div class="footer-contact">
        <a href="tel:+16787273854">678-727-3854</a>
        <a href="mailto:majormaintenanceir@gmail.com"
          >jordan.a.mcghee@hotmail.com</a
        >
        <p>Nashville, TN &amp; Surrounding Areas</p>
      </div>
    </footer>
  </main>
</div>

<script>
  const header = document.querySelector(".header");
  const toggle = document.querySelector(".menu-toggle");
  const nav = document.querySelector("#site-nav");

  function setMenu(open: boolean) {
    nav?.classList.toggle("is-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    document.body.classList.toggle("menu-open", open);
  }

  toggle?.addEventListener("click", () => {
    setMenu(!nav?.classList.contains("is-open"));
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });

  header
    ?.querySelector(".logo")
    ?.addEventListener("click", () => setMenu(false));

  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenu(false);
  });

  let headerScrolled = false;

  function updateHeaderScroll() {
    const y = window.scrollY;
    // Hysteresis: different enter/exit thresholds so padding/layout
    // changes can't flip the class back and forth near the top.
    if (!headerScrolled && y > 48) {
      headerScrolled = true;
      header?.classList.add("is-scrolled");
    } else if (headerScrolled && y < 12) {
      headerScrolled = false;
      header?.classList.remove("is-scrolled");
    }
  }

  updateHeaderScroll();
  window.addEventListener("scroll", updateHeaderScroll, { passive: true });

  const carousel = document.querySelector("[data-carousel]");
  const track = carousel?.querySelector(".carousel-track");
  const prev = carousel?.querySelector(".carousel-btn.prev");
  const next = carousel?.querySelector(".carousel-btn.next");

  function scrollCarousel(direction: number) {
    if (!(track instanceof HTMLElement)) return;
    const slide = track.querySelector(".carousel-slide");
    const amount = slide instanceof HTMLElement ? slide.offsetWidth + 16 : 280;
    track.scrollBy({ left: amount * direction, behavior: "smooth" });
  }

  prev?.addEventListener("click", () => scrollCarousel(-1));
  next?.addEventListener("click", () => scrollCarousel(1));

  const form = document.querySelector("[data-contact-form]");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const status = form.querySelector(".form-status");
    if (form instanceof HTMLFormElement) form.reset();
    if (status instanceof HTMLElement) status.hidden = false;
  });
</script>

<style>
  :root {
    --red-light: #f00a0b;
    --red: #ce0613;
    --red-dark: #a01420;
    --metal-light: #f4f4f4;
    --metal-mid: #b8b8b8;
    --metal-dark: #6e6e6e;
    --ink: #111;
    --paper: #f3f1ed;
    --dark-dark: #0a0a0a;
    --medium-dark: #222222;
    --light-dark: #474747;
    --dark-gradient: linear-gradient(
      90deg,
      var(--dark-dark) 0%,
      var(--medium-dark) 50%,
      var(--dark-dark) 100%
    );
    --red-gradient: linear-gradient(
      180deg,
      var(--red-light) 0%,
      var(--red-dark) 100%
    );
    --red-gradient-horizontal: linear-gradient(
      90deg,
      var(--red-dark) 0%,
      var(--red) 50%,
      var(--red-dark) 100%
    );
    --stainless-steel: linear-gradient(
      90deg,
      #787878 0%,
      #b5b5b5 25%,
      #e3e3e3 50%,
      #b5b5b5 75%,
      #787878 100%
    );
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 5.5rem;
  }

  :global(body) {
    margin: 0;
    background: var(--dark-gradient);
    color: var(--ink);
    font-family: Oswald, "Arial Narrow", sans-serif;
    line-height: 1.45;
  }

  :global(body.menu-open) {
    overflow: hidden;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 7vw, 4rem);
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 0.98;
    text-transform: uppercase;
  }

  .page {
    min-height: 100%;
  }

  .page img {
    border-radius: 4px;
  }

  .wrap {
    width: min(1080px, calc(100% - 2.5rem));
    margin-inline: auto;
  }

  .band-light {
    background-color: var(--paper);
    background-image: var(--marble-white);
    background-size: cover;
    background-position: center;
  }

  .text-gradient {
    background: var(--red-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .text-light {
    color: #f5f5f5;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2rem 1.5rem;
    background: transparent;
    backdrop-filter: blur(2px);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      backdrop-filter 0.25s ease;
  }

  .header.is-scrolled {
    background: #fff;
    backdrop-filter: blur(12px);
    border-bottom-color: rgba(0, 0, 0, 0.08);
  }

  .logo {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo img {
    display: block;
    height: clamp(3.5rem, 10vw, 5.5rem);
    width: auto;
  }

  .menu-toggle {
    display: none;
    position: relative;
    z-index: 30;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    color: var(--ink);
  }

  .menu-toggle-bar {
    display: block;
    width: 1.6rem;
    height: 0.18rem;
    margin: 0.28rem auto;
    background: currentColor;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle-bar:nth-child(1) {
    transform: translateY(0.46rem) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle-bar:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle-bar:nth-child(3) {
    transform: translateY(-0.46rem) rotate(-45deg);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav a {
    color: #2a2a2a;
    text-decoration: none;
    font-size: 1.25rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .nav a:hover {
    color: var(--red);
  }

  .hero {
    padding: 5.5rem 0 3.5rem;
    margin-left: max(1.25rem, calc((100% - 1080px) / 2));
    margin-right: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
  }

  .hero .text-gradient {
    position: relative;
    display: inline-block;
    line-height: inherit;
  }

  .hero .text-gradient-base {
    background: var(--red-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .hero .shimmer {
    position: absolute;
    inset: 0;
    display: block;
    background: linear-gradient(
      105deg,
      transparent 35%,
      rgba(255, 255, 255, 0.5) 50%,
      transparent 65%
    );
    background-size: 250% 100%;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    pointer-events: none;
    animation: hero-shimmer 2.8s ease-in-out;
  }

  @keyframes hero-shimmer {
    0% {
      background-position: 150% 0;
    }

    100% {
      background-position: -50% 0;
    }
  }

  .hero-logo {
    display: block;
    width: min(100%, 450px);
    max-width: 100%;
    height: auto;
    margin-inline: auto;
  }

  .eyebrow {
    margin: 0 0 0.85rem;
    font-size: 1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #5a5854;
  }


  .hero-logo {
    display: block;
    margin-top: 0.15em;
    color: #111;
    -webkit-text-fill-color: #111;
  }

  .subtitle {
    margin: 1.1rem 0 1.75rem;
    max-width: 28rem;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: clamp(1.05rem, 2.4vw, 1.25rem);
    font-style: italic;
    color: #333;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.35rem;
    border: 0;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--red) 0%, var(--red-dark) 100%);
    color: #fff;
    font: inherit;
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }

  .btn:hover {
    filter: brightness(1.08);
  }

  .contact-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    padding: 0 0 2.75rem;
    list-style: none;
    margin: 0 auto;
  }

  .contact-item {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    text-align: center;
  }

  .icon-circle {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 2px solid var(--red);
    border-radius: 50%;
    color: var(--red);
    background: rgba(255, 255, 255, 0.55);
  }

  .icon-circle svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .contact-label {
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
  }

  .contact-item a,
  .contact-value {
    color: #1a1a1a;
    text-decoration: none;
    font-size: 1rem;
    line-height: 1.3;
    word-break: break-word;
  }

  .contact-item a:hover {
    color: var(--red);
  }

  .section-break {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    padding: 2rem 1rem;
    margin-top: -1px;
  }

  .section-break-dark {
    background: transparent;
    padding: 2rem 1rem;
    background: var(--red-gradient-horizontal);
    border-bottom: 16px solid transparent;
    border-top: 16px solid transparent;
    border-image: var(--stainless-steel) 1;
  }

  .section-break-dark:has(+ .band) {
    padding-bottom: 1.5rem;
  }

  .section-break-text {
    position: relative;
    z-index: 1;
    display: inline-flex;
    gap: 0.4rem;
    font-size: clamp(1.5rem, 3vw, 1.75rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f5f5f5;
  }

  .section {
    padding: 2.5rem 0 3.25rem;
  }

  #services {
    padding-top: 1.875rem;
  }

  .services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.15rem 2rem;
    margin: 0;
    padding: 3rem 0 2rem;
    list-style: none;
  }

  .service {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 0;
    font-size: 1.5rem;
    letter-spacing: 0.02em;
    color: #f2f2f2;
  }

  .service-check {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    margin-top: 0.12rem;
    color: var(--red);
  }

  #work {
    padding-bottom: 8rem;
  }

	#contact {
		padding 8rem 0;
	}

  .carousel {
    position: relative;
  }

  .carousel-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(min(78vw, 340px), 1fr);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 0.5rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  .carousel-slide {
    margin: 0;
